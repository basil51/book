# Copy to .env.prod on the server and fill in secrets. Used with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Public site: https://book.sparkco.vip
# Public API: https://api.book.sparkco.vip
BASE_DOMAIN=sparkco.vip

DATABASE_USER=postgres
DATABASE_PASSWORD=change_this_to_a_long_random_password
DATABASE_NAME=appointment

# Must not be the literal "your_super_secret_key"
JWT_SECRET=change_this_to_a_long_random_hex_or_string

# Let's Encrypt — required on the SAME host when you start Traefik with the production profile
# (see DEPLOY.md). Traefik uses this for certificate issuance.
ACME_EMAIL=you@yourdomain.com

# Backend: transactional email (Resend) and optional WhatsApp (Twilio)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=appointments@yourdomain.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Stripe (server-side secret only)
# STRIPE_SECRET_KEY=sk_live_...
