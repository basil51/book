// shared/tsconfig.json
{
    "compilerOptions": {
      "target": "ES2023",
      "module": "commonjs",
      "outDir": "./dist",
      "baseUrl": "./",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "node_modules",
      "dist"
    ]
  }