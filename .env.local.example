# Copy to .env.local and adjust. Used with:
#   docker compose --env-file .env.local -f docker-compose.local.yml up -d --build
#
# Base domain (no protocol). Hostnames become:
#   book.<BASE_DOMAIN>       → frontend (via Traefik)
#   api.book.<BASE_DOMAIN>   → backend API (via Traefik)
BASE_DOMAIN=sparkco.localhost

# PostgreSQL (must match between postgres service and backend)
DATABASE_USER=postgres
# Do not use the literal "postgres" as password — NestJS rejects it in production mode.
DATABASE_PASSWORD=local_dev_db_password
DATABASE_NAME=appointment

# JWT signing secret — must not be the literal "your_super_secret_key"
JWT_SECRET=local_dev_jwt_change_me

# Optional: override public API base URL used by the frontend container at runtime
# (client bundle may still need a rebuild if you rely on NEXT_PUBLIC_* at build time)
# NEXT_PUBLIC_API_URL=http://api.book.sparkco.localhost

# --- Email / SMS (backend) — optional for local Docker ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=onboarding@resend.dev
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Payments (backend) — optional ---
# STRIPE_SECRET_KEY=sk_test_...
